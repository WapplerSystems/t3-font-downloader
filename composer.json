{
    "name": "wapplersystems/font-downloader",
    "description": "Automatically downloads external CSS fonts (Google Fonts, Font Awesome, ...) and serves them locally for GDPR compliance",
    "type": "typo3-cms-extension",
    "homepage": "https://wappler.systems",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "google-fonts",
        "font-awesome",
        "gdpr",
        "privacy",
        "local-fonts"
    ],
    "require": {
        "typo3/cms-core": "^14"
    },
    "replace": {
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\FontDownloader\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "font_downloader"
        }
    },
    "authors": [
        {
            "name": "Sven Wappler",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ]
}
