{
    "name": "wapplersystems/font-downloader",
    "description": "Font downloader for TYPO3",
    "type": "typo3-cms-extension",
    "homepage": "https://github.com/WapplerSystems/t3-font-downloader",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "google",
        "fonts"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/t3-font-downloader/issues",
        "source": "https://github.com/WapplerSystems/t3-font-downloader"
    },
    "require": {
        "typo3/cms-core": "^13"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\FontDownloader\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "font_downloader"
        }
    }
}